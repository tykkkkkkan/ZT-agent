node_modules/
dist/
.npm/
.yarn-integrity
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
dist-ssr/
*.local

# ===== MySQL / 数据库 =====
*.sql.bak
*.sql.gz
