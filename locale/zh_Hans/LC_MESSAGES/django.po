# 中渔天下 Django Admin 中文翻译覆盖
# 作用：补齐 django-unfold 模板中未被 Django 自带 zh-hans 目录覆盖的英文字符串，
#       并修正个别错误译文（如 "Delete selected" 被误译为 "取消选中"）。
msgid ""
msgstr ""
"Project-Id-Version: 中渔天下\n"
"Report-Msgid-Bugs-To: \n"
