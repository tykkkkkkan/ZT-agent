# 中渔天下 ZT-agent 环境变量模板
# 复制本文件为 .env 并填写真实值

# MySQL 数据库密码
DB_PASSWORD=

# DeepSeek API Key（AI 客服对话用）
DEEPSEEK_API_KEY=

# ── 认证（JWT）配置（可选，不填则用默认值）──
# access token 有效期（分钟，默认 30）
JWT_ACCESS_MINUTES=30
# refresh token 有效期（天，默认 7）
JWT_REFRESH_DAYS=7
# JWT 签名密钥（可选；**留空即自动回退使用 Django SECRET_KEY**，本地/演示保持留空即可）
# 注意：生产环境若单独设置，请填足够随机的值；留空是安全的，不会导致登录失败。
JWT_SIGNING_KEY=
# 登录失败锁定阈值（次，默认 5）
LOGIN_MAX_ATTEMPTS=5
# 登录失败锁定时长（分钟，默认 15）
LOGIN_LOCKOUT_MINUTES=15

# ── 安全配置（生产环境必填）──
# Django 密钥（生产必须换成随机强密钥，本地可留空用默认值）
DJANGO_SECRET_KEY=
# 调试模式（本地 True，生产 False）
DEBUG=True
# 允许访问的主机（逗号分隔；生产填你的域名）
ALLOWED_HOSTS=127.0.0.1,localhost
# CORS 白名单（逗号分隔；生产填前端实际域名）
# 注意：docker-compose 把 web 映射到宿主机 8001，所以 8001 两个来源必须在内，
# 否则浏览器访问 http://localhost:8001 时接口会被 CORS 拦截。
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8001,http://localhost:8001

# ── RAG 后端（可选，默认 tfidf 零依赖）──
# tfidf = 自研 TF-IDF + 内存向量库（无需额外配置）
# embedding = 真实语义向量 + Chroma 向量库（需配置下面的 embedding key 并 pip install chromadb）
RAG_BACKEND=tfidf

# Embedding 服务（仅 RAG_BACKEND=embedding 时需要）
# 默认指向 OpenAI 兼容端点，可换成硅基流动/阿里云 DashScope 等兼容服务
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=

# Chroma 持久化目录（可选）
CHROMA_PERSIST_DIR=

# ── 生产化配置（P0/P1/P2 优化项，均有默认值，可不填）──
# Redis 缓存后端（生产填 redis://redis:6379/1；不填则回退进程内 LocMem）
REDIS_URL=
# 聊天接口限流（次数/窗口秒）
RATE_CHAT_LIMIT=20
RATE_CHAT_WINDOW=60
# 通用 API 限流
RATE_API_LIMIT=120
RATE_API_WINDOW=60
# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO
# 对话输入安全审核（1 开启；0/false 关闭，仅保留长度校验）
CONTENT_MODERATION=1
# 单条聊天输入最大长度
MAX_INPUT_LEN=2000
# RAG BM25 重排权重（cosine 与字面分混合比例 0~1）
RAG_BM25_WEIGHT=0.5
# 慢请求告警阈值（毫秒）
SLOW_REQUEST_MS=2000
# 错误上报（可选：填 DSN 并 pip install sentry-sdk 后启用）
SENTRY_DSN=
SENTRY_ENV=production
SENTRY_TRACES_RATE=0.1

